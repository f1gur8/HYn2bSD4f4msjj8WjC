<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>fe1b8abd-b6ba-4c45-9b5e-e02e203ec4fe</ProjectGuid>
    <RootNamespace>RiskAgilityFM</RootNamespace>
    <Keyword>RiskAgility FM</Keyword>
    <ProjectFileVersion>3.11.0.0</ProjectFileVersion>
    <AllowDebugSymbols>true</AllowDebugSymbols>
    <CoreType>Gen1</CoreType>
    <Processor>Cpu</Processor>
    <Precision>Double</Precision>
    <Name>RiskAgility FM Tutorial</Name>
    <RunManager />
    <RunPage />
    <ProjectionTask />
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Code Manager.mmf">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Increased run length.rps">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Increased output length.ops">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Testing.opm">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Valuation.ipm">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Base Goal Seek.gsk">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Base output requirements.ops">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Profit Testing.ipm">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Revenue Account.opm">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Base run parameter set.rps">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Tutorial Run Manager.rmr">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Wildcards.wcd">
      <Subtype>Content</Subtype>
    </Content>
    <Content Include="Referenced Files.rfs">
      <Subtype>Content</Subtype>
    </Content>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.default.props" />
  <PropertyGroup Label="Configuration">
    <OutputPath>$(OutDir)</OutputPath>
    <IntermediateOutputPath>$(OutDir)</IntermediateOutputPath>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseOfMfc>false</UseOfMfc>
    <CharacterSet>MultiByte</CharacterSet>
    <PlatformToolset>v143</PlatformToolset>
    <DebugSymbols>$(AllowDebugSymbols)</DebugSymbols>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputPath>$(OutDir)</OutputPath>
    <DebugSymbols>$(AllowDebugSymbols)</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputPath>$(OutDir)</OutputPath>
    <DebugSymbols>$(AllowDebugSymbols)</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(RafmToolsPath)\TW.Rafm.targets" />
    <Import Project="$(RafmToolsPath)\CompileLinkProperties.targets" />
  </ImportGroup>
</Project>